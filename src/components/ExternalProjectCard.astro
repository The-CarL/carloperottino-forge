---
import TagList from './TagList.astro';
import type { ExternalProject } from '../data/external-projects';

interface Props {
  project: ExternalProject;
}

const { project } = Astro.props;
const tags = [project.language, ...(project.topics ?? [])].filter(
  (tag): tag is string => Boolean(tag),
);
---

<a
  href={project.githubUrl}
  target="_blank"
  rel="noreferrer"
  class="group rounded-lg border border-surface-3 bg-surface-2/30 hover:border-accent/30 hover:bg-surface-2/60 transition-all duration-300 overflow-hidden block"
>
  <div class="aspect-[16/10] bg-gradient-to-br from-surface-2 to-surface-3 flex items-center justify-center">
    <svg
      viewBox="0 0 24 24"
      class="w-10 h-10 text-warm-dim group-hover:text-accent transition-colors duration-300"
      aria-hidden="true"
    >
      <path
        fill="currentColor"
        d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.71.5.1.68-.22.68-.49 0-.24-.01-1.04-.01-1.88-2.78.62-3.37-1.21-3.37-1.21-.45-1.2-1.11-1.51-1.11-1.51-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.86.09-.67.35-1.13.64-1.39-2.22-.26-4.55-1.15-4.55-5.1 0-1.13.39-2.05 1.03-2.77-.1-.26-.45-1.31.1-2.73 0 0 .84-.28 2.75 1.06A9.3 9.3 0 0 1 12 6.8c.85 0 1.7.12 2.5.35 1.9-1.34 2.74-1.06 2.74-1.06.55 1.42.2 2.47.1 2.73.64.72 1.03 1.64 1.03 2.77 0 3.96-2.34 4.83-4.57 5.09.36.32.68.93.68 1.88 0 1.36-.01 2.45-.01 2.79 0 .27.18.6.69.49A10.24 10.24 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z"
      />
    </svg>
  </div>

  <div class="p-4">
    <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-warm-dim">GitHub project <span aria-hidden="true">↗</span></div>

    <h3 class="text-base font-semibold text-cream group-hover:text-accent transition-colors mt-2">
      {project.title}
    </h3>

    <p class="text-xs text-warm-gray mt-1 line-clamp-2">
      {project.description}
    </p>

    {tags.length > 0 && (
      <div class="mt-2 flex flex-wrap items-center gap-2">
        <TagList tags={tags} compact />
      </div>
    )}
  </div>
</a>
